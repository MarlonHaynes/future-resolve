{
  "name": "future-resolve",
  "private": true,
  "version": "1.0.0",
  "description": "AI-assisted support ticket triage app",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "migrate": "node -r dotenv/config server/scripts/runSql.js schema.sql",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5"
  }
}
