# ---------------------------------------------------------------------------
# Future Resolve — environment variables
# Copy this file to `.env` in the project root, then fill in real values.
# The server automatically loads the root .env no matter where it's started
# from. Never commit the real .env file (it is already git-ignored).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase-compatible).
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB

# Google Gemini API key, used for live ticket classification.
# Get one at https://aistudio.google.com/apikey
# If this is left as the placeholder value (or unset), the app automatically
# falls back to a deterministic mock classifier — see server/src/services/classifier.ts
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Secret used to sign/verify JWTs. Use a long random string in production,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Port the Express API listens on (optional, defaults to 4000)
PORT=4000

# Base URL of the API, used by the Vite dev server proxy / frontend build
VITE_API_URL=http://localhost:4000
